[Unit]
Description=BatMon-ha Bluetooth BMS to MQTT Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5s
User=homeassistant
WorkingDirectory=/home/homeassistant/batmon-ha
ExecStart=/home/homeassistant/batmon-ha/venv/bin/python3 main.py

[Install]
WantedBy=multi-user.target

